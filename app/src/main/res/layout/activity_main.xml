<?xml version="1.0" encoding="utf-8"?>
<!--
  Both screens share one layout scheme so nothing overlaps and controls don't jump around:
  - Top row: an info panel on the left that takes the remaining width, and the screen's
    action button on the right (Clear selection / Center on me).
  - Bottom stack: details or loading, then the screen toggle (Globe / AR camera) in the same
    spot, size and style on both screens.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- ================= AR screen ================= -->
    <FrameLayout
        android:id="@+id/arLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.jakedonnini.sattracker.ui.SkyOverlayView
            android:id="@+id/skyOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Zoom for the camera hole; only shown while a locked satellite is centered. -->
        <com.jakedonnini.sattracker.ui.VerticalSlider
            android:id="@+id/zoomSlider"
            android:layout_width="64dp"
            android:layout_height="240dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Debug HUD: live readout of every data source. Tap to collapse. -->
                <TextView
                    android:id="@+id/debugHud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- Right column: Clear selection, then heading alignment. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <Button
                    android:id="@+id/clearSelection"
                    style="@style/OverlayButton"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/alignButton"
                    style="@style/OverlayButton"
                    android:text="@string/align" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom stack: details for the focused / last-locked satellite, then the screen toggle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Heading alignment panel, opened by the Align button: Sun/Moon or magnetometer. -->
            <LinearLayout
                android:id="@+id/alignBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/alignText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/alignCompass"
                        style="@style/OverlayButton"
                        android:layout_marginEnd="8dp"
                        android:text="@string/align_compass" />

                    <Button
                        android:id="@+id/alignBody"
                        style="@style/OverlayButton"
                        android:text="@string/align_moon" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shown when a locked satellite is in the reticle. -->
            <Button
                android:id="@+id/analyzeButton"
                style="@style/OverlayButton"
                android:layout_marginBottom="8dp"
                android:text="@string/analyze"
                android:visibility="gone" />

            <TextView
                android:id="@+id/infoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_panel"
                android:lineSpacingExtra="2dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/openGlobe"
                style="@style/ScreenToggleButton"
                android:text="@string/open_globe" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= Globe screen (also the loading screen) ================= -->
    <FrameLayout
        android:id="@+id/globeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <WebView
            android:id="@+id/globeWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/globeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Right column: actions, then the Layers dropdown opening beneath them. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <Button
                    android:id="@+id/centerOnMe"
                    style="@style/OverlayButton"
                    android:text="@string/center_on_me"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/layersButton"
                    style="@style/OverlayButton"
                    android:layout_marginTop="8dp"
                    android:text="@string/layers"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layersPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/layerVisibility"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="#FFFFFF"
                        android:checked="true"
                        android:text="@string/layer_visibility"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/layerFov"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="#FFFFFF"
                        android:checked="true"
                        android:text="@string/layer_fov"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/layerHorizon"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="#FFFFFF"
                        android:checked="true"
                        android:text="@string/layer_horizon"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/layerInView"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="#FFFFFF"
                        android:checked="true"
                        android:text="@string/layer_in_view"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                    <CheckBox
                        android:id="@+id/layerOutOfView"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:buttonTint="#FFFFFF"
                        android:checked="true"
                        android:text="@string/layer_out_of_view"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom stack: loading bar while starting up, then the screen toggle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/loadingPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/loadingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/loadingBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressTint="#FFD54F" />
            </LinearLayout>

            <Button
                android:id="@+id/openAr"
                style="@style/ScreenToggleButton"
                android:layout_marginTop="12dp"
                android:text="@string/open_ar"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= Analyze panel (over either screen) ================= -->
    <ScrollView
        android:id="@+id/analysisPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/analysisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/analysisSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#B0B0B0"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp">

                <ImageView
                    android:id="@+id/analysisImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/analysis_image_description"
                    android:maxHeight="260dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/analysisProgress"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/analysisImageNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#909090"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/analysisBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#FFFFFF"
                android:textColorLink="#80DEEA"
                android:textSize="14sp" />

            <Button
                android:id="@+id/analysisClose"
                style="@style/ScreenToggleButton"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="@string/close" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
