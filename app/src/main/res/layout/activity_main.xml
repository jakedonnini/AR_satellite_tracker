<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- ================= AR screen ================= -->
    <FrameLayout
        android:id="@+id/arLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.jakedonnini.sattracker.ui.SkyOverlayView
            android:id="@+id/skyOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Debug HUD: live readout of every data source. Tap to collapse. -->
        <TextView
            android:id="@+id/debugHud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_panel"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <!-- Back to the globe (external view). -->
        <Button
            android:id="@+id/openGlobe"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_clear_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/open_globe"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Bottom stack: details for the focused / last-locked satellite, then the clear button. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/infoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:lineSpacingExtra="2dp"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/clearSelection"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_clear_button"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= Globe screen (also the loading screen) ================= -->
    <FrameLayout
        android:id="@+id/globeLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <WebView
            android:id="@+id/globeWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/globeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_panel"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/centerOnMe"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_clear_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/center_on_me"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- Loading bar, replaced by the "Open AR camera" button when the data is ready. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/loadingPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/loadingLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/loadingBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:progressTint="#FFD54F" />
            </LinearLayout>

            <Button
                android:id="@+id/openAr"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/bg_clear_button"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/open_ar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
